{
  "name": "agentdock-starter-backend-nestjs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --env-file=../../.env ../../node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start": "../../node_modules/@nestjs/cli/bin/nest.js build && node --env-file=../../.env dist/main.js",
    "build": "../../node_modules/@nestjs/cli/bin/nest.js build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "../../node_modules/@nestjs/cli/bin/nest.js build && node --test --test-concurrency=1 tests/*.test.js"
  },
  "dependencies": {
    "agentdock-starter-server-core": "0.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^26.0.0",
    "typescript": "^5.8.0"
  }
}
