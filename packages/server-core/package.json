{
  "name": "agentdock-starter-server-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=1 tests/sandbox*.test.js",
    "test:db": "node --test --test-concurrency=1 tests/conversation-postgres.test.js tests/conversation-restart.test.js",
    "test:load": "node --test --test-concurrency=1 tests/conversation-load.test.js"
  },
  "dependencies": {
    "@agentdock-ai/agentdock": "^0.2.0",
    "@agentdock-ai/contracts": "^0.2.0",
    "@agentdock-ai/conversations": "^0.1.1",
    "@langchain/core": "1.2.11",
    "@langchain/langgraph": "1.4.18",
    "@langchain/langgraph-checkpoint": "^1.1.5",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.5",
    "@langchain/openrouter": "0.4.13",
    "langchain": "1.5.10",
    "pg": "^8.23.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/pg": "^8.0.0",
    "typescript": "^5.8.0"
  }
}
